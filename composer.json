{
    "name": "password-cockpit/backend",
    "description": "Password-cockpit backend",
    "type": "project",
    "homepage": "https://github.com/passwordcockpit/backend",
    "license": "BSD-3-Clause",
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "ocramius/package-versions": true,
            "laminas/laminas-component-installer": true
        }
    },
    "require": {
        "php": "^8.4",
        "doctrine/migrations": "^3.9",
        "doctrine/orm": "^3.6",
        "firebase/php-jwt": "^7.0",
        "laminas/laminas-authentication": "^2.19",
        "laminas/laminas-component-installer": "^3.7.0",
        "laminas/laminas-config-aggregator": "^1.19.0",
        "laminas/laminas-hydrator": "^4.18",
        "laminas/laminas-i18n": "^2.32",
        "laminas/laminas-i18n-resources": "^2.13",
        "laminas/laminas-inputfilter": "^2.35",
        "laminas/laminas-ldap": "^2.19",
        "laminas/laminas-paginator": "^2.22",
        "laminas/laminas-permissions-rbac": "^3.8",
        "laminas/laminas-servicemanager": "^3.24",
        "laminas/laminas-stratigility": "^4.3",
        "mezzio/mezzio": "3.27",
        "mezzio/mezzio-hal": "^2.13",
        "mezzio/mezzio-helpers": "^5.20",
        "mezzio/mezzio-laminasrouter": "^3.12",
        "mezzio/mezzio-problem-details": "^1.19",
        "mezzio/mezzio-router": "^3.20",
        "roave/psr-container-doctrine": "^5.0",
        "symfony/cache": "^7.4",
        "tuupola/cors-middleware": "^1.5",
        "jimtools/jwt-auth": "^3.0",
        "zircote/swagger-php": "^4.2"
    },
    "require-dev": {
        "codeception/codeception": "^4.1",
        "codeception/module-phpbrowser": "^2.0",
        "codeception/module-rest": "^2.0",
        "laminas/laminas-development-mode": "^3.15",
        "phpunit/phpunit": "^9.5",
        "rector/rector": "^1.2",
        "roave/security-advisories": "dev-master",
        "squizlabs/php_codesniffer": "^3.4.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/App/src/",
            "Authentication\\": "src/Authentication/src/",
            "Authorization\\": "src/Authorization/src/",
            "User\\": "src/User/src",
            "Folder\\": "src/Folder/src",
            "Password\\": "src/Password/src",
            "Log\\": "src/Log/src",
            "File\\": "src/File/src"
        },
        "files": [
            "config/constants.local.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "AppTest\\": "test/AppTest/"
        }
    },
    "scripts": {
        "post-create-project-cmd": [
            "@development-enable"
        ],
        "development-disable": "laminas-development-mode disable",
        "development-enable": "laminas-development-mode enable",
        "development-status": "laminas-development-mode status",
        "check": [
            "@cs-check",
            "@test"
        ],
        "clear-config-cache": "php bin/clear-config-cache.php",
        "cs-check": "phpcs",
        "cs-fix": "phpcbf",
        "test-debug": [
            "@test-init",
            "sudo php vendor/bin/codecept run --debug",
            "@test-clear"
        ],
        "test": [
            "@test-init",
            "sudo php vendor/bin/codecept run",
            "@test-clear"
        ],
        "swagger": [
            "./vendor/bin/openapi -o ./swagger/swagger.json -e vendor src/ -l"
        ]
    }
}